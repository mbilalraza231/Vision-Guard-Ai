FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install
COPY alerts/requirements.txt /app/alerts/requirements.txt
RUN pip install --no-cache-dir -r /app/alerts/requirements.txt

# Copy source code
COPY alerts/ /app/alerts/
COPY backend/app/core/ /app/backend/app/core/
COPY backend/app/utils/ /app/backend/app/utils/
COPY backend/app/services/settings_defaults.py /app/backend/app/services/settings_defaults.py
COPY backend/app/services/runtime_settings.py /app/backend/app/services/runtime_settings.py
COPY backend/app/services/__init__.py /app/backend/app/services/__init__.py

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Create log directory
RUN mkdir -p /var/log/visionguard

# Command to run the worker
CMD ["python", "-m", "alerts.worker"]
