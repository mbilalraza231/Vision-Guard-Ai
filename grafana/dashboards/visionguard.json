{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "CPU % per service (camera = ALL forked processes)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(process_cpu_seconds_total{job!=\"vg-camera\"}[1m])) * 100",
          "legendFormat": "{{job}}",
          "refId": "A"
        },
        {
          "expr": "rate(vg_container_cpu_seconds_total[1m]) * 100",
          "legendFormat": "vg-camera (parent + children)",
          "refId": "B"
        }
      ],
      "description": "100% = one core. Services that fork (camera) do not report child CPU via process_* metrics, so vg_container_cpu_seconds_total sums /proc for every process in that container."
    },
    {
      "id": 2,
      "title": "Memory per service (MB)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job!=\"vg-camera\"} / 1024 / 1024",
          "legendFormat": "{{job}} (RSS)",
          "refId": "A"
        },
        {
          "expr": "vg_container_memory_bytes / 1024 / 1024",
          "legendFormat": "vg-camera (PSS, parent + children)",
          "refId": "B"
        }
      ],
      "description": "Camera uses PSS (proportional set size): parent and children share the interpreter, OpenCV and the shared-frame buffers, so plain RSS would be double counted."
    },
    {
      "id": 3,
      "title": "Camera Frames Ingested (rate/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(vg_camera_frames_total{status=\"ingested\"}[1m]) or vector(0)",
          "legendFormat": "{{camera_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Camera Streams",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(vg_camera_active_streams{job=\"vg-camera\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Detections by Worker (rate/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(vg_ai_detections_total[1m]) or vector(0)",
          "legendFormat": "{{model_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 100,
      "title": "P95 Inference & End-to-End Latency (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vg_ai_inference_duration_seconds_bucket[1m]))) or vector(0)",
          "legendFormat": "P95 Inference Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vg_pipeline_end_to_end_duration_seconds_bucket[1m]))) or vector(0)",
          "legendFormat": "P95 End-to-End Latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "title": "Redis Queue Backlog Depth",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (queue_name) (vg_ai_queue_depth) or vector(0)",
          "legendFormat": "{{queue_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 102,
      "title": "P95 Clip Recording & Cloud Upload (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vg_clip_recording_duration_seconds_bucket[5m]))) or vector(0)",
          "legendFormat": "P95 clip recording (capture + encode)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vg_clip_upload_duration_seconds_bucket[5m]))) or vector(0)",
          "legendFormat": "P95 Cloudinary upload",
          "refId": "B"
        }
      ],
      "description": "Recording duration tracks clip length (post_seconds) and queue concurrency — it is the CPU cost of the encode pipeline.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "title": "Clip Throughput & Pending Work",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(vg_clip_recording_duration_seconds_count[5m])) or vector(0)",
          "legendFormat": "clips recorded /s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vg_clip_upload_duration_seconds_count[5m])) or vector(0)",
          "legendFormat": "clips uploaded /s",
          "refId": "B"
        },
        {
          "expr": "vg_clip_pending_count or vector(0)",
          "legendFormat": "pending recordings",
          "refId": "C"
        }
      ],
      "description": "recorded/s below incoming event rate means the recorder is falling behind.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      }
    }
  ],
